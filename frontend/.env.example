# Spring Boot backend. Server Components call it directly; the browser goes through
# the rewrites in next.config.ts.
BACKEND_URL=http://localhost:8080

# The STOMP endpoint the browser dials. Next's rewrites do not proxy WebSocket
# upgrades, so this points straight at the backend. Bidders authenticate with a
# single-use ticket from /api/ws-ticket, since deployed the backend is another site.
# Deployed: wss://<oracle-ip-dashed>.sslip.io/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Shows the local sign-in panel that talks to the backend's dev profile.
# Never set this on Vercel.
NEXT_PUBLIC_DEV_AUTH=true
