# Discord app: https://discord.com/developers/applications
#   Redirect URI  http://localhost:3000/login/oauth2/code/discord
#   Scope         identify
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret

# Comma-separated Discord user ids that become ADMIN on login (enable Developer Mode
# in Discord, then right-click your name -> Copy User ID).
ADMIN_DISCORD_IDS=

# Where a successful login returns the browser.
FRONTEND_URL=http://localhost:3000

HENRIK_API_KEY=
